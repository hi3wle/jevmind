{
  "name": "jevmind",
  "version": "0.1.0",
  "description": "Adaptive coding harness for Claude Code and Codex",
  "license": "MIT",
  "repository": "github:hi3wle/jevmind",
  "type": "module",
  "files": [
    "plugin",
    ".claude-plugin",
    ".agents/plugins"
  ],
  "bin": {
    "jevmind": "plugin/dist/jevmind.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=plugin/dist/jevmind.mjs --banner:js=\"#!/usr/bin/env node\" && chmod +x plugin/dist/jevmind.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.7.0",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@clack/prompts": "1.8.1",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
