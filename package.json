{
  "name": "jodex",
  "version": "0.1.0",
  "description": "Adaptive coding harness for Claude Code and Codex",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "bin": {
    "jodex": "plugin/dist/jodex.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=plugin/dist/jodex.mjs --banner:js=\"#!/usr/bin/env node\" && chmod +x plugin/dist/jodex.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.7.0",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
